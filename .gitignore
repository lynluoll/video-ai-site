# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# temporary signed image-generation responses
/public/media/display-v2/**/response.json
/public/media/display-v2/**/urls.txt
/public/media/display-v2/multi-size/
/public/media/display-v2/seasonal/
/public/media/display-v2/selling-points/
/public/media/display-v2/rejected/
/public/media/display-v2/final/**/contact-sheet.png

# generated local research and unused runtime artifacts
/.vite/
/diagrams/
/docs/
/output/
/public/media/sofa/haven-sofa.glb
/public/media/sofa/model-viewer.min.js

# Runtime video belongs in TOS/CDN, not Git. Existing legacy videos remain
# tracked, but all newly added video assets are ignored.
/public/**/*.mp4
/public/**/*.mov
/public/**/*.webm
/public/**/*.m4v
